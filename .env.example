# Auth.js / NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public site URL for metadata / OG (production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications for new reservas.
# Preferred: Varmail POST endpoint (keep secret)
VARMAIL_URL=
# Fallback: Resend: https://resend.com/api-keys)
RESEND_API_KEY=
NOTIFY_EMAIL=nicolasortizarmesto@gmail.com
RESEND_FROM=Avisos inmobiliarias <onboarding@resend.dev>
